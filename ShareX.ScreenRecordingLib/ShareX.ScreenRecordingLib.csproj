<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Linux screen recording (ffmpeg / PipeWire / PulseAudio / V4L2)</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The original Windows implementation (Media Foundation, WASAPI, Windows.Graphics.Capture). Kept for reference only. -->
    <Compile Remove="LegacyWindows\**" />
    <EmbeddedResource Remove="LegacyWindows\**" />
    <None Remove="LegacyWindows\**" />
  </ItemGroup>
</Project>
