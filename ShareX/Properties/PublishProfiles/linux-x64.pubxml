<?xml version="1.0" encoding="utf-8"?>
<!--
  ShareX for Linux - self-contained publish profile.

  Usage (from the repository root):

      source scripts/linux/env.sh
      dotnet publish ShareX/ShareX.csproj -c Release -p:PublishProfile=linux-x64

  or, equivalently, scripts/linux/publish.sh which wraps the command above.

  Output: dist/linux-x64/ShareX  (single self-contained file, no .NET SDK needed at runtime)
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Startup speed: the single file is NOT compressed (decompressing ~100 MB on every process start cost ~0.3 s; the release archive is compressed anyway)
         and the managed code is precompiled (ReadyToRun) so Avalonia/Skia are not JIT-compiled on every start, including the overlay helper that starts per capture. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>$(MSBuildProjectDirectory)/../dist/linux-x64/</PublishDir>
  </PropertyGroup>
</Project>
