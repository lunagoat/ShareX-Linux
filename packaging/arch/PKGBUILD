# Maintainer: ShareX Linux port <noreply@example.com>
#
# ShareX for Arch Linux / CachyOS, built from source with `dotnet publish`.
#
# This PKGBUILD builds the checkout it lives in: it expects to be run from
# packaging/arch/ inside the ShareX repository (the Linux port), because the port
# is not part of an upstream release yet:
#
#     cd packaging/arch
#     makepkg -f -i          # -i installs the package, no sudo needed for the build
#
# makedepends lists dotnet-sdk; if you only have the user-local SDK in ~/.dotnet
# (the layout this repository's scripts/linux/env.sh uses), run
#
#     makepkg -f --nodeps -i
#
# and the build() function will pick up ~/.dotnet automatically.
#
# TODO(packaging): when the port is released, replace the local source with a
# pinned tag/archive and drop the `$startdir` reference, e.g.
#   source=("$pkgname-$pkgver.tar.gz::https://github.com/ShareX/ShareX/archive/refs/tags/v$pkgver.tar.gz")

pkgname=sharex-linux
pkgver=21.0.0
pkgrel=1
pkgdesc='Screen capture, file sharing and productivity tool (native Linux port)'
arch=('x86_64' 'aarch64')
url='https://getsharex.com'
license=('GPL-3.0-only')
depends=(
    'glibc'
    'gcc-libs'
    'zlib'
    'bzip2'
    'libpng'
    'expat'
    'brotli'
    'fontconfig'
    'freetype2'
    'icu'
    'krb5'
    'openssl'
    'dbus'
    'systemd-libs'
    'util-linux'
    'libx11'
    'libxau'
    'libxdmcp'
    'libxcb'
    'libxext'
    'libxfixes'
    'libxi'
    'libxrandr'
    'libxrender'
    'libxcursor'
    'libice'
    'libsm'
    'libdrm'
    'libglvnd'
)
makedepends=('dotnet-sdk')
optdepends=(
    'ffmpeg: screen recording, video conversion and GIF encoding'
    'grim: screen capture on wlroots compositors (Hyprland, sway)'
    'slurp: region selection on wlroots compositors (Hyprland, sway)'
    'gpu-screen-recorder: hardware accelerated screen recording on Wayland'
    'wl-clipboard: clipboard images, text and file lists on Wayland'
    'xdg-desktop-portal: screenshot, screen cast and global shortcut portals'
    'xdg-desktop-portal-hyprland: portal backend for Hyprland'
    'xdg-desktop-portal-gtk: portal backend for GTK/GNOME sessions'
    'xdg-desktop-portal-kde: portal backend for KDE Plasma'
    'tesseract: OCR text recognition'
    'tesseract-data-eng: English OCR language data'
    'libnotify: desktop notifications'
    'xdg-utils: open files, folders and URLs with xdg-open'
    'xclip: clipboard support on X11'
    'xdotool: window inspection and input simulation on X11'
    'mpv: video player tool'
    'pipewire: system audio capture'
    'v4l-utils: camera (V4L2) device enumeration and control'
    'gnome-shell-extension-appindicator: tray icon on GNOME Shell'
)
# The published binary is a self-contained single-file .NET bundle: stripping it
# would corrupt the bundle, and there are no managed symbols to strip.
options=('!strip' '!debug')

# Build from the repository this PKGBUILD is part of (packaging/arch/).
_repo="$startdir/../.."
source=()

build() {
    local rid

    case "$CARCH" in
        x86_64) rid='linux-x64' ;;
        aarch64) rid='linux-arm64' ;;
        *) error "Unsupported architecture: $CARCH"; exit 1 ;;
    esac

    cd "$_repo"

    # Prefer a SDK-payload dotnet (this is what scripts/linux/env.sh installs into
    # ~/.dotnet on development machines); otherwise use whatever is on PATH.
    if [ -d "$HOME/.dotnet/sdk" ]; then
        export DOTNET_ROOT="$HOME/.dotnet"
        export PATH="$DOTNET_ROOT:$PATH"
    fi

    if ! dotnet --list-sdks >/dev/null 2>&1; then
        echo "error: no .NET SDK found; install dotnet-sdk or provide ~/.dotnet" >&2
        exit 1
    fi

    export DOTNET_CLI_TELEMETRY_OPTOUT=1
    export DOTNET_NOLOGO=1

    msg "Publishing ShareX ($rid, self-contained single file)"
    dotnet publish ShareX/ShareX.csproj \
        -c Release \
        -r "$rid" \
        -p:PublishProfile=linux-x64 \
        -p:PublishDir="$srcdir/publish/" \
        -p:DebugType=none \
        -p:DebugSymbols=false \
        -nologo
}

check() {
    # Make sure the published executable is at least a loadable binary. A full
    # smoke test needs a display server, so it is done by CI/QA instead.
    file "$srcdir/publish/ShareX" | grep -q 'ELF 64-bit'
}

package() {
    install -d "$pkgdir/usr/lib/sharex" \
        "$pkgdir/usr/bin" \
        "$pkgdir/usr/share/applications" \
        "$pkgdir/usr/share/metainfo" \
        "$pkgdir/usr/share/mime/packages" \
        "$pkgdir/usr/share/licenses/$pkgname"

    # Application files (runtime + native messaging host manifests + file icon).
    for f in "$srcdir/publish"/*; do
        [ -f "$f" ] || continue
        install -m644 "$f" "$pkgdir/usr/lib/sharex/$(basename "$f")"
    done
    chmod 755 "$pkgdir/usr/lib/sharex/ShareX"
    printf '%s\n' "$pkgver" > "$pkgdir/usr/lib/sharex/version"

    install -m755 "$_repo/packaging/linux/sharex" "$pkgdir/usr/bin/sharex"

    install -m644 "$_repo/packaging/linux/sharex.desktop" \
        "$pkgdir/usr/share/applications/sharex.desktop"
    install -m644 "$_repo/packaging/linux/io.github.ShareX.ShareX.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/io.github.ShareX.ShareX.metainfo.xml"
    install -m644 "$_repo/packaging/linux/sharex.xml" \
        "$pkgdir/usr/share/mime/packages/sharex.xml"

    for size in 16 24 32 48 64 128 256; do
        install -Dm644 "$_repo/packaging/linux/icons/hicolor/${size}x${size}/apps/sharex.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/sharex.png"
    done
    install -Dm644 "$_repo/packaging/linux/icons/hicolor/scalable/apps/sharex.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/sharex.svg"

    install -m644 "$_repo/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
}
